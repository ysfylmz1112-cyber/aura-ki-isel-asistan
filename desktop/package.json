{
  "name": "aura-desktop",
  "version": "6.4.0",
  "private": true,
  "description": "AURA local desktop AI assistant",
  "main": "main.cjs",
  "scripts": {
    "start": "electron .",
    "dev": "electron .",
    "build:win": "electron-builder --win nsis --publish never",
    "prepare-renderer": "node prepare-renderer.cjs",
    "prestart": "npm run prepare-renderer",
    "prebuild:win": "npm run prepare-renderer",
    "test": "node --check main.cjs && node --check shorts-renderer.cjs && node --test ../tests/local-ai-quality.test.cjs ../tests/youtube-studio.test.cjs",
    "test:ai-quality": "node --check main.cjs && node --check shorts-renderer.cjs && node --test ../tests/local-ai-quality.test.cjs ../tests/youtube-studio.test.cjs"
  },
  "dependencies": {
    "duck-duck-scrape": "2.2.7",
    "qrcode": "1.5.4",
    "electron-updater": "^6.6.2"
  },
  "devDependencies": {
    "electron": "44.5.0",
    "electron-builder": "26.16.1"
  },
  "build": {
    "appId": "com.aura.personalassistant",
    "productName": "AURA",
    "artifactName": "AURA-${version}-Setup.exe",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.cjs",
      "preload.cjs",
      "prepare-renderer.cjs",
      "renderer/**/*",
      "package.json",
      "openclaw.cjs",
      "income.cjs",
      "marketing.cjs",
      "youtube-studio.cjs",
      "shorts-renderer.cjs"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "executableName": "AURA"
    },
    "asar": true,
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "AURA"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "ysfylmz1112-cyber",
        "repo": "aura-ki-isel-asistan",
        "releaseType": "release"
      }
    ]
  }
}
